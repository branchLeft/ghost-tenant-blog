/bin/
/node_modules/
Pulumi.*.yaml.bak
/preview.json
# The deploy job writes the slot key here on the runner. Ignored so a local
# reproduction of that step cannot commit a private key.
/deploy_key
__pycache__/

graphify-out/

# This repo tracks pnpm-lock.yaml and CI runs `pnpm install --frozen-lockfile`;
# an npm install here is a mistake, and its lockfile must not get committed --
# ignored so a stray `npm install` can't silently reintroduce it.
package-lock.json

{{!< default}}
<article class='post'>
  <header class='post-header'>
    <h1 class='post-title'>{{title}}</h1>
    {{#if feature_image}}
      <img class='post-feature-image' src='{{feature_image}}' alt='{{feature_image_alt}}' />
    {{/if}}
  </header>
  <section class='post-content'>
    {{content}}
  </section>
</article>
